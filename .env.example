OPENAI_API_KEY="your-openai-api-key-here"

# Seeded once at startup if the account doesn't already exist.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# Powers the contact form (https://resend.com — free tier is fine).
RESEND_API_KEY="your-resend-api-key-here"
CONTACT_EMAIL_TO="you@example.com"

# Signs session cookies — set to any long random string.
SESSION_SECRET="change-me-to-a-random-string"

# Set to "production" when deployed (enables secure cookies over HTTPS).
ENV="development"
